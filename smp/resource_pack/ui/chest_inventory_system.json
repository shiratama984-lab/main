{
  "namespace": "smp_native_inventory",
  "inventory_label": {
    "type": "label",
    "text": "container.inventory",
    "color": "$title_text_color",
    "layer": 2,
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "ignored": "(not $smp_show_inventory)"
  },
  "hotbar_items": {
    "type": "stack_panel",
    "size": [
      "default",
      18
    ],
    "orientation": "horizontal",
    "collection_name": "form_buttons",
    "$size": "$condition",
    "$start_index": "$smp_slot_count",
    "ignored": "(not $smp_show_inventory)",
    "controls": [
      {
        "0@smp_native_inventory.inventory_item_panel": {
          "collection_index": "$start_index"
        }
      },
      {
        "1@smp_native_inventory.inventory_item_panel": {
          "collection_index": "($start_index + 1)"
        }
      },
      {
        "2@smp_native_inventory.inventory_item_panel": {
          "collection_index": "($start_index + 2)"
        }
      },
      {
