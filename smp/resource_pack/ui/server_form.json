{
  "namespace": "server_form",
  "long_form": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "native@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "common_dialogs.standard_title_label",
          "$title_size": [
            "100% - 14px",
            10
          ],
          "$text_name": "#title_text",
          "$title_text_binding_type": "none",
          "$child_control": "server_form.long_form_panel",
          "size": [
            225,
            200
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (not ((#title_text - '§0[SMP:CHEST]§r ') = #title_text)))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "chest@common_dialogs.main_panel_no_buttons": {
          "$title_panel": "smp_chest.title",
          "$title_size": [
            "100% - 14px",
            12
          ],
          "$child_control": "smp_chest.content",
          "size": [
            280,
            242
          ],
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#title_text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§0[SMP:CHEST]§r ') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
