{
  "namespace": "smp_chest",
  "title": {
    "type": "label",
    "text": "#page_title",
    "color": [
      1,
      1,
      1
    ],
    "text_alignment": "center",
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text - '§0[SMP:CHEST]§r ')",
        "target_property_name": "#page_title"
      }
    ]
  },
  "content": {
    "type": "panel",
    "size": [
      264,
      208
    ],
    "controls": [
      {
        "background": {
          "type": "image",
          "texture": "textures/smp/chest",
          "size": [
            "100%",
            "100%"
          ],
          "layer": 0
        }
      },
      {
        "summary": {
          "type": "label",
          "text": "#form_text",
          "color": [
            0.08,
            0.1,
            0.13
          ],
          "size": [
            248,
            26
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [
            0,
            4
          ],
          "font_scale_factor": 0.75,
          "text_alignment": "center",
          "layer": 2,
          "bindings": [
            {
              "binding_name": "#form_text"
            }
          ]
        }
      },
      {
        "grid": {
          "type": "grid",
          "size": [
            252,
            168
          ],
          "offset": [
            6,
            34
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "grid_dimensions": [
            9,
            6
          ],
          "grid_item_template": "smp_chest.slot",
          "collection_name": "form_buttons",
          "layer": 3
        }
      }
    ]
  },
  "slot@common.button": {
    "size": [
      28,
      28
    ],
    "$pressed_button_name": "button.form_button_click",
    "default_control": "normal",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "locked_control": "normal",
    "controls": [
      {
        "normal": {
          "type": "image",
          "texture": "textures/smp/slot",
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "hover": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ],
          "controls": [
            {
              "highlight": {
                "type": "image",
                "texture": "textures/smp/slot_hover",
                "size": [
                  "100%",
                  "100%"
                ]
              }
            },
            {
              "tooltip": {
                "type": "custom",
                "renderer": "hover_text_renderer",
                "allow_clipping": false,
                "layer": 30,
                "bindings": [
                  {
                    "binding_name": "#form_button_text",
                    "binding_name_override": "#hover_text",
                    "binding_type": "collection",
                    "binding_collection_name": "form_buttons"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "textures/smp/slot_pressed",
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "icon": {
          "type": "image",
          "size": [
            22,
            22
          ],
          "layer": 4,
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#form_button_text = ''))",
        "target_property_name": "#enabled"
      }
    ]
